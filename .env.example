# Copy to .env and fill in. .env is git-ignored.

# EIA Open Data API v2 - instant key:
#   https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ENTSO-E Transparency Platform "Web API Security Token".
# Make a free account, then email transparency@entsoe.eu from that account
# asking for API access; they flip it on and the token appears in your
# account settings.
ENTSOE_API_KEY=

# Hugging Face Hub needs no key for public model metadata.
