# Copy this file to .env and fill in the values. .env is git-ignored.

# EIA Open Data API v2 - instant, self-service:
#   https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ENTSO-E Transparency Platform - free, but not instant:
#   1. create an account at https://transparency.entsoe.eu
#   2. email transparency@entsoe.eu from that address asking for
#      "Web API access"; they enable a security token on your account
#   3. copy the token here
ENTSOE_API_KEY=

# Hugging Face needs no key.
